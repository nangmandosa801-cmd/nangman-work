_p=OUT+s+f'/nangman_interior_{s}_post.html'; _h=open(_p).read(); _kw=T.split(',')[0]   # 사진 설명에 검색어를 넣는다(SEO 점검 ⑥) — 사진 파일은 그대로
_h=re.sub(r'(nangman_interior_'+s+r'_\w+\.(?:jpg|png) — )(?!낭만 인테리어 안내)(?!'+re.escape(_kw)+')',lambda m:m.group(1)+_kw+' · ',_h); open(_p,'w').write(_h)
