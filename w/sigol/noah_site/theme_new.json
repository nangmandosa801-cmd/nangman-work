tion:absolute;inset:0;background:linear-gradient(0deg,rgba(19,45,35,.73),transparent 70%)}.hero-copy{position:absolute;z-index:1;bottom:10%;left:9%;color:white;max-width:720px}.eyebrow{font-size:12px;letter-spacing:2px;font-weight:500}.hero h1{font-size:clamp(38px,4.1vw,66px);line-height:1.28;letter-spacing:-2.5px;font-weight:500;margin:18px 0 24px}.hero p{max-width:470px;font-size:16px;line-height:1.9}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}.button{display:inline-flex;justify-content:center;align-items:center;border-radius:28px;padding:12px 25px;font-size:14px;font-weight:600;min-height:48px;background:var(--forest);color:white}.hero .button{background:var(--paper);color:var(--forest)}.hero .button.secondary{background:transparent;border:1px solid #ffffffa0;color:white}.section{max-width:1200px;margin:auto;padding:100px 35px}.section-heading{text-align:center;margin-bottom:42px}.section-heading h2{font-size:34px;letter-spacing:-1.3px;line-height:1.4;font-weight:500;margin:12px 0}.section-heading p{color:var(--muted);font-size:15px}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.card img{aspect-ratio:4/3;border-radius:10px}.card .season{font-size:12px;color:var(--muted);margin-top:20px}.card h3{font-size:22px;font-weight:500;margin:8px 0}.card p{font-size:14px;color:var(--muted);margin:0}.text-link{display:inline-block;margin-top:17px;font-size:13px;font-weight:600}.story{background:var(--sage)}.split{display:grid;grid-template-columns:1.15fr 1fr;gap:65px;align-items:center}.split img{aspect-ratio:4/3;border-radius:10px}.split h2{font-size:36px;line-height:1.45;letter-spacing:-1.5px;font-weight:500}.split p{font-size:15px;color:#536459}.products{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}.products img{aspect-ratio:1;border-radius:10px}.products h3{font-size:17px;font-weight:500;margin:14px 0 0}.products p{font-size:13px;color:var(--muted);margin-top:3px}.stay{background:var(--bluewash)}.stay .split{grid-template-columns:1fr 1.15fr}.contact{max-width:none;text-align:center;padding:75px 24px;background:var(--forest);color:var(--paper)}.contact h2{font-weight:500;font-size:31px;margin:0 0 15px}.contact p{font-size:14px;color:#dce5da}.contact .button{background:var(--paper);color:var(--forest)}footer{padding:38px 6vw;font-size:12px;color:var(--muted);display:flex;gap:30px;justify-content:space-between}.mobile-menu{display:none}.note{font-size:11px;opacity:.8}main{overflow:hidden}@media(max-width:700px){header{padding:17px 22px}.brand{font-size:23px}header>nav{display:none}.mobile-menu{display:block;position:relative}.mobile-menu summary{cursor:pointer;font-size:14px}.mobile-menu nav{position:absolute;right:0;top:35px;background:var(--paper);padding:20px;width:180px;z-index:10;display:flex;flex-direction:column;gap:16px;box-shadow:0 8px 30px #233d3320}.hero{min-height:610px;height:80svh;max-height:850px}.hero-copy{left:7%;right:7%;bottom:8%}.hero h1{font-size:39px;letter-spacing:-1.8px}.hero p{font-size:14px}.section{padding:65px 23px}.section-heading h2{font-size:29px}.cards{grid-template-columns:1fr;gap:38px}.split,.stay .split{grid-template-columns:1fr;gap:25px}.split h2{font-size:29px}.products{grid-template-columns:repeat(2,1fr);gap:26px 16px}.products h3{font-size:16px}.stay .split>div{order:2}.stay .split>img{order:1}footer{display:block;padding:30px 23px}.hero .actions{gap:8px}.button{padding:11px 20px}}\n\n/* 메뉴 글(소개·체험 등) 화면 — 같은 색 · 글꼴로 맞춤 */\n.wrap{max-width:1200px;margin:auto;padding:0 35px}\n.page-head{position:relative;margin:0 calc(50% - 50vw);min-height:340px;display:flex;align-items:flex-end;padding:50px 9%;color:#fff;background:var(--forest) center/cover no-repeat}\n.page-head:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(19,45,35,.73),transparent 75%)}\n.page-head h1{position:relative;z-index:1;font-size:clamp(30px,3.6vw,48px);font-weight:500;letter-spacing:-1.5px;margin:0}\narticle.single{max-width:760px;margin:0 auto;padding:70px 0 90px}\n.page .lead{font-size:19px;font-weight:500}\n.page h2{font-size:24px;font-weight:500;letter-spacing:-.8px;margin:56px 0 10px}\n.page p,.page li{font-size:15px;color:#3d5148}\n.page .note{background:var(--sage);border-radius:10px;padding:16px 20px;margin-top:40px}\n.page .big{font-size:34px;font-weight:600;color:var(--forest)}\n.page .items{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;margin:30px 0}\n.page .item{background:#fff;border-radius:10px;overflow:hidden}\n.page .item h3{font-size:18px;font-weight:500;margin:14px 18px 2px}.page .item p{margin:0 18px 10px}\n.page .item .price{color:var(--forest);font-weight:600;padding-bottom:12px}\n.page .item img{aspect-ratio:1}\n.list{display:grid;gap:12px;padding:60px 0}.list a{background:#fff;border-radius:10px;padding:18px 22px}\n@media(max-width:700px){.wrap{padding:0 23px}.page-head{min-height:240px;padding:34px 7%}article.single{padding:46px 0 60px}.page .items{grid-template-columns:1fr}}\n\n]]></b:skin>\n</head>\n<body>\n<header><a class=\"brand\" href=\"https://noahforest-hoengseong.blogspot.com/\">노아의숲<small>HOENGSEONG · BIRCH FOREST</small></a><nav aria-label=\"주 메뉴\"><a href=\"https://noahforest-hoengseong.blogspot.com/2026/11/blog-post.html\">소개</a><a href=\"https://noahforest-hoengseong.blogspot.com/2026/11/blog-post_17.html\">숲 체험</a><a href=\"https://noahforest-hoengseong.blogspot.com/2026/11/blog-post_100.html\">숲에서 난 것</a><a href=\"https://noahforest-hoengseong.blogspot.com/2026/11/blog-post_128.html\">머무르기</a><a href=\"https://noahforest-hoengseong.blogspot.com/2026/11/blog-post_261.html\">오시는 길</a><a class=\"nav-call\" href=\"tel:01028828165\">예약 문의</a></nav><details class=\"mobile-menu\"><summary>메뉴</summary><nav aria-label=\"모바일 메뉴\"><a href=\"https://noahforest-hoengseong.blogspot.com/2026/11/blog-post.html\">소개</a><a href=\"https://noahforest-hoengseong.blogspot.com/2026/11/blog-post_17.html\">숲 체험</a><a href=\"https://noahforest-hoengseong.blogspot.com/2026/11/blog-post_100.html\">숲에서 난 것</a><a href=\"https://noahforest-hoengseong.blogspot.com/2026/11/blog-post_128.html\">머무르기</a><a href=\"https://noahforest-hoengseong.blogspot.com/2026/11/blog-post_261.html\">오시는 길</a></nav></details></header>\n<main>\n<b:if cond='data:view.isHomepage'><div id='home'/><div class='section' id='news'/></b:if>\n<div class='wrap'>\n<b:section id='main' showaddelement='false'>\n<b:widget id='Blog1' locked='true' title='글' type='Blog' version='2' visible='true'>\n<b:includable id='main'>\n<b:if cond='data:view.isSingleItem'>\n<b:loop values='data:posts' var='post'>\n<div class='page-head' expr:data-title='data:post.title'><h1><data:post.title/></h1></div>\n<article class='single'><data:post.body/></article>\n</b:loop>\n<b:elseif cond='!data:view.isHomepage'/>\n<div class='list'><b:loop values='data:posts' var='post'><a expr:href='data:post.url'><strong><data:post.title/></strong></a></b:loop></div>\n</b:if>\n</b:includable>\n</b:widget>\n</b:section>\n</div>\n</main>\n<footer><div><strong>노아의숲</strong><br/>강원특별자치도 횡성군 갑천면 화전리</div><div>숲 · 계절 체험 · 먹거리 · 머무르기<br/><span class=\"note\">그림은 숲과 체험을 표현한 일러스트입니다. 실제 시설·상품 모습과 다를 수 있습니다.</span></div></footer>\n<script>//<![CDATA[\n(function(){\nfunction imgs(root){root.querySelectorAll('[data-img]').forEach(function(el){var u=el.getAttribute('data-img');if(/^https?:/.test(u)){el.style.setProperty('--img','url('+u+')');if(el.classList.contains('hero'))el.style.backgroundImage='linear-gradient(180deg,rgba(20,30,22,.05),rgba(20,30,22,.72)),url('+u+')';}});}\nimgs(document);\nvar pg=document.querySelector('article.single .page');var ph=document.querySelector('.page-head');\nif(pg&&ph){var u=pg.getAttribute('data-img');if(/^https?:/.test(u||''))ph.style.backgroundImage='linear-gradient(180deg,rgba(20,30,22,0),rgba(20,30,22,.7)),url('+u+')';}\nvar home=document.getElementById('home');if(!home)return;\nfunction feed(label,n){return fetch('/feeds/posts/default/-/'+encodeURIComponent(label)+'?alt=json&max-results='+n).then(function(r){return r.json()}).then(function(j){return j.feed.entry||[]});}\nfeed('홈',1).then(function(e){if(e[0]){home.innerHTML=e[0].content.$t;imgs(home);}});\nfeed('소식',3).then(function(e){if(!e.length)return;var h='<h2>숲 소식</h2><div class=\"list\">';e.forEach(function(x){var l=x.link.filter(function(k){return k.rel=='alternate'})[0];h+='<a href=\"'+l.href+'\"><strong>'+x.title.$t+'</strong></a>';});document.getElementById('news').innerHTML=h+'</div>';});\n})();\n//]]></script>\n</body>\n</html>\n"
