[{"action": "left_click", "coordinate": [560, 1278], "action_summary": "Focuses the message box"}, {"action": "type", "text": "현대2차부동산 대표님, 안녕하세요. 네이버 블로그 「낭만 부동산 분석 플랫폼」을 쓰고 있습니다.", "action_summary": "Types a message line"}, {"action": "key", "text": "shift+Return", "action_summary": "Adds a line break"}, {"action": "type", "text": "위파크 일곡공원 입주를 앞두고 단지 앞 사무소를 찾아가 현장 이야기를 듣는 인터뷰를 하고 있습니다. 멀리 계셔서 전화 인터뷰도 괜찮습니다.", "action_summary": "Types a message line"}, {"action": "key", "text": "shift+Return", "action_summary": "Adds a line break"}, {"action": "type", "text": "저는 현장 이야기로 위파크 일곡공원 글의 독자를 늘리고, 대표님은 그 글을 읽는 입주민 · 세입자에게 사무소를 알리는 셈입니다. 서로 얻는 게 있어서 따로 비용을 받지 않습니다.", "action_summary": "Types a message line"}, {"action": "key", "text": "shift+Return", "action_summary": "Adds a line break"}, {"action": "type", "text": "30분쯤 이야기를 들은 뒤 블로그에 올리며, 원고는 먼저 확인받습니다. 그다음부터 위파크 일곡공원 글을 쓸 때마다 사무소 소개를 넣어 드립니다.", "action_summary": "Types a message line"}, {"action": "key", "text": "shift+Return", "action_summary": "Adds a line break"}, {"action": "type", "text": "가능하신 요일만 답장 주세요.", "action_summary": "Types a message line"}, {"action": "key", "text": "shift+Return", "action_summary": "Adds a line break"}, {"action": "type", "text": "https://blog.naver.com/dong_jin_kim/224449575744", "action_summary": "Types a message line"}, {"action": "key", "text": "shift+Return", "action_summary": "Adds a line break"}, {"action": "type", "text": "010-2882-8165", "action_summary": "Types a message line"}, {"action": "key", "text": "Return", "action_summary": "Sends the interview request SMS to 010-5152-0170"}, {"action": "wait", "duration": 3}, {"action": "zoom", "region": [420, 0, 896, 1344], "scale": 0.45}, {"action": "key", "text": "ctrl+n", "action_summary": "Opens a new message"}, {"action": "wait", "duration": 1}, {"action": "type", "text": "01068558108", "action_summary": "Enters recipient number"}, {"action": "key", "text": "Return", "action_summary": "Confirms recipient"}, {"action": "wait", 